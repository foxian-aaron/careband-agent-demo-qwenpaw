{
  "name": "careband-agent-demo",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node backend/src/server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:frontend": "vitest run src",
    "test:backend": "node --test \"backend/tests/**/*.test.js\"",
    "test:verification": "node --test \"scripts/tests/*.test.mjs\"",
    "test:all": "npm run test:frontend && npm run test:backend",
    "verify:repository": "node scripts/check-repository-boundaries.mjs",
    "verify:three-runs": "node scripts/verify-three-runs.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^5.6.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
